# tailcat-proxy 配置示例。复制到 --data-path 目录（默认 data/）下命名为
# config.yaml 并修改密码。真实配置文件含明文密码，已被 git 忽略，权限请保持 0600。
socks:
  users:
    # tailcat: 只能访问 dns.txt 命中的域名（走隧道）
    tailcat: "changeme"
    # all: 可访问任意目标（命中走隧道，未命中直连）
    all: "changeme"

history:
  # 关掉后不打开数据库，管理页的"历史连接"标签会显示未启用。
  # 历史库固定落在 --data-path 目录下的 history.db。
  enabled: true
